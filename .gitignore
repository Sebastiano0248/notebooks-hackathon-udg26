# ==========================
# Core Python
# ==========================
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
# (Common names for virtual envs)
venv/
.venv/
env/
.env/
ENV/

# ==========================
# VS Code
# ==========================
.vscode/
*.code-workspace
# Local history for VS Code (if using extensions like 'Local History')
.history/

# ==========================
# Jupyter Notebooks
# ==========================
# Checkpoints created by Jupyter
.ipynb_checkpoints/

# IPython configuration
profile_default/
ipython_config.py

# ==========================
# Data Science & Machine Learning
# ==========================
# Pandas/Data: Ignore large datasets to prevent bloat
# Keep these if you want to track small config files, but usually data is ignored.
*.tsv
*.parquet
*.feather
*.h5
*.hdf5

# Specific Data Directories (Best Practice: Keep structure, ignore content)
# It is common to have a 'data' folder. Ignore everything inside it...


# ...except a .gitkeep file (create this empty file to track the folder)

# ==========================
# Models & Artifacts (Scikit-learn, etc.)
# ==========================
# Serialized models
*.pkl
*.pickle
*.joblib
*.sav

# Neural Network weights (if you add TensorFlow/PyTorch later)
*.pt
*.pth
*.keras
*.onnx

# Model outputs/metrics
*.mo
*.pot

# ==========================
# Visualization / Plots
# ==========================
# Often generated dynamically, so usually not tracked
# *.png
# *.jpg
# *.jpeg
# *.svg
# *.pdf
# (Unless they are specific assets for a README)

# ==========================
# Environment Variables (SECURITY CRITICAL)
# ==========================
# NEVER commit secrets, API keys, or database passwords
.env
.env.local
.env.*.local

# ==========================
# Operating System Files
# ==========================
.DS_Store
Thumbs.db
